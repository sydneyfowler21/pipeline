# Copy to .env for local development. Never commit real values.
# Render: set the same names on the web service. The database is external Neon.

# Postgres connection string. Neon: use the pooled URL.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/pipeline

# HMAC pepper for session ids. At least 32 characters. Generate a random value.
SESSION_SECRET=replace-with-at-least-32-random-characters

# AES-256-GCM key for slice-2 TOTP secrets. At least 32 characters. Required now so deploys fail closed.
ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Public origin of this service (no trailing path). Email links use it. CSRF allows this origin.
APP_URL=http://localhost:5173

# Optional. When set, verify and reset mail goes through Resend. When unset, dev prints mail to the console
# and tests keep it in an in-memory sink.
RESEND_API_KEY=

# Optional sender. Defaults to Pipeline <noreply@example.test>
MAIL_FROM=

# Optional override: resend | console | memory
MAIL_TRANSPORT=

# Slice 2 (GitHub OAuth). Not used yet. Leave blank.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional listen port. Defaults to 3000.
PORT=3000

# How many reverse proxies append to X-Forwarded-For. The client IP is this many entries from the right.
# 0 ignores X-Forwarded-For and uses the socket address. Unset defaults to 0.
# Set 1 only when that proxy is the sole route to the app (Render). A wrong hop count reopens IP spoofing.
TRUSTED_PROXY_HOPS=0
